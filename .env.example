# Copy to .env.local for local development. Never commit real values.
# Names only — see docs/setup.md for where each value comes from.

# Public base URL of the app (used for absolute links in printed documents and emails).
NEXT_PUBLIC_APP_URL=

# --- Database (Neon PostgreSQL) — required from Phase 2 ---
# Pooled connection string, used by the application at runtime.
DATABASE_URL=
# Direct (unpooled) connection string, used by Drizzle migrations.
DATABASE_URL_UNPOOLED=

# --- Student / parent portal sessions — required from Phase 3 ---
# Random secret of at least 32 characters, e.g. `openssl rand -base64 48`.
STUDENT_SESSION_SECRET=

# --- Neon Auth (staff authentication) — added in Phase 3 ---
# The exact variable names are confirmed when Neon Auth is provisioned.
