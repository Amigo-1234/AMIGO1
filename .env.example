# Copy to .env.local for local development. Never commit real values.
# Names only — see docs/setup.md for where each value comes from.

# Public base URL of the app (used for absolute links in printed documents and emails).
NEXT_PUBLIC_APP_URL=

# --- Database (Neon PostgreSQL) — required from Phase 2 ---
# Pooled connection string, used by the application at runtime.
DATABASE_URL=
# Direct (unpooled) connection string, used by Drizzle migrations.
DATABASE_URL_UNPOOLED=
# Optional: set to 1 only where outbound traffic must go through HTTPS_PROXY (db scripts).
DATABASE_PROXY_TUNNEL=

# --- Staff authentication (Neon Auth) — required from Phase 3 ---
# Neon console → your project → Auth → Configuration: the Auth URL.
NEON_AUTH_BASE_URL=
# Random secret of at least 32 characters, e.g. `openssl rand -base64 48`.
NEON_AUTH_COOKIE_SECRET=

# --- Student / parent sign-in — required from Phase 3 ---
# Random secret of at least 32 characters. Peppers PIN hashes: changing it invalidates every
# PIN and legacy password, so set it once and keep it safe.
STUDENT_AUTH_SECRET=

# --- First Super Admin setup — temporary ---
# Random code of at least 32 characters that unlocks /<locale>/staff/setup until the first
# Super Admin exists. Remove it after setup.
STAFF_BOOTSTRAP_TOKEN=
